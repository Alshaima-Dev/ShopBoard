{
  "name": "shopboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.js\" \"*.config.js\" \"*.json\" .prettierrc.json index.html",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.js\" \"*.config.js\" \"*.json\" .prettierrc.json index.html",
    "lint": "eslint src tests vite.config.js eslint.config.js lint-staged.config.js --max-warnings=0",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5"
  }
}
